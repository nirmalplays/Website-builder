# Google AI Studio -> Get API key. Never commit the real value.
GEMINI_API_KEY=
# Optional second Google project. The free tier is metered per project, so a
# second key is a second quota pool of the same models, joining the fallback
# chain as its own provider. It does not help with capacity-side 503s.
GEMINI_API_KEY_2=

# Optional override. Flash tier is fast enough that the demo feels live.
GEMINI_MODEL=gemini-2.5-flash

# Postgres (Neon or Supabase). Optional: without it the app runs, it just does not save.
#
# On Supabase use the POOLER host, not db.<ref>.supabase.co. The direct host is
# IPv6-only and serverless platforms (Vercel included) have no IPv6 egress, so
# every query fails - quietly, because persistence is fail-soft, which means
# saved projects and the rate limits silently stop working:
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 6543 is transaction mode (right for serverless; lib/db sets prepare:false for
# it), 5432 is session mode.
DATABASE_URL=

# Supabase (Project Settings > API). Optional: without these, auth UI hides and the app runs anonymously.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Daily generation caps (FR-8/FR-9). Anonymous gets a trial; signing in raises it.
LIMIT_ANONYMOUS=10
LIMIT_SIGNED_IN=100

# Raise or lower without a redeploy. GLOBAL_DAILY_CAP=0 disables the app-wide valve.
GLOBAL_DAILY_CAP=500

# Model provider. Leave AI_PROVIDER empty to use every configured provider
# below as fallback capacity: if the current model is busy or has run out of
# its own daily quota, the build keeps going on the next configured one
# instead of failing. Set AI_PROVIDER to pin to exactly one, old-style.
#   gemini             (needs GEMINI_API_KEY)
#   openai-compatible  (Ollama, vLLM, llama.cpp, LM Studio, your own server...)
#   groq / openrouter / mistral / huggingface / nvidianim / ollamacloud / aionlabs /
#   modelscope / siliconflow / kilocode / ovhcloud / llm7
AI_PROVIDER=
AI_BASE_URL=
AI_MODELS=
AI_API_KEY=
AI_TIMEOUT_MS=180000

# Free-tier providers (see github.com/mnfst/awesome-free-llm-apis). Every one
# below is optional and additive - set any subset of these keys and that
# vendor's free models join the fallback chain. Get each key from the
# vendor's own dashboard.
# NVIDIA NIM is the most generous on the list at 10,000 requests/day.
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Mistral free tier is ~1 request/second - fine as fallback, not for bursts.
MISTRAL_API_KEY=
HF_TOKEN=
OLLAMA_API_KEY=
AIONLABS_API_KEY=
MODELSCOPE_API_KEY=
SILICONFLOW_API_KEY=
# These two work anonymously; a key only raises the rate limit.
LLM7_API_KEY=
OVH_API_KEY=
# Kilo Code needs no key at all - it's active as soon as the app starts.

# Self-hosted sandpack-bundler, so previews stop calling CodeSandbox.
NEXT_PUBLIC_SANDPACK_BUNDLER_URL=

# Live APIs a generated app may call. Without these it keeps faking a server
# with setTimeout, which is why generated apps were frontend-only.
#
# A generated app runs in a browser sandbox with no server of its own, so the
# alternative is putting your key in client-side source where anyone who opens
# the preview can read it. These route the call through /api/proxy instead: the
# key stays here and never reaches the browser.
#
#   PROXY_<NAME>_URL   the upstream base URL          (required)
#   PROXY_<NAME>_KEY   the secret                     (optional)
#   PROXY_<NAME>_AUTH  bearer | header:X-Api-Key | query:apikey | none
#
# The app then calls https://<this-app>/api/proxy/<name>/<path>. Only the
# upstreams declared here can be reached - there is no wildcard, because an
# open proxy holding your key is a way for strangers to spend it.
#
# Example - a weather API keyed by query parameter:
#   PROXY_WEATHER_URL=https://api.openweathermap.org/data/2.5
#   PROXY_WEATHER_AUTH=query:appid
#
# Example - a REST API with a bearer token:
#   PROXY_CRM_URL=https://api.example.com/v1
#   PROXY_CRM_AUTH=bearer

# Absolute URL of this deployment, used to build the proxy URLs handed to
# generated apps. Inferred from VERCEL_URL when unset.
NEXT_PUBLIC_APP_URL=

# Encrypts the API credentials users paste into the app (Supabase keys, Stripe
# keys and so on) before they are written to the database. Required before the
# app will accept any credential - without it, keys would sit in plain text in
# a database whose connection string has itself been shared.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this makes every stored credential unreadable; they must be
# re-entered. That is the correct behaviour, not a bug.
CONNECTION_SECRET=

# Hard stop on spend per UTC day, in USD, across the whole deployment. Checked
# before a generation starts. 0 disables it. Pro has no free tier and a build
# costs real money, so the request cap alone is not a spend cap.
DAILY_SPEND_CAP_USD=5

# Anthropic. Claude models join the picker and the fallback chain when set.
# The key starts sk-ant-api03- and is shown once, at creation. The apikey_...
# string in the console's key list is the key's ID, not the key.
ANTHROPIC_API_KEY=
